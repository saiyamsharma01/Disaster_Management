{
  "name": "ivr-functions",
  "version": "1.0.0",
  "private": true,
  "description": "Firebase Cloud Functions for the IVR workflow",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf lib",
    "deploy": "npm run clean && npm run build",
    "lint": "eslint --ext .ts src",
    "test": "vitest --config vitest.config.ts --run"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "firebase-admin": "^12.5.0",
    "firebase-functions": "^4.9.0",
    "qs": "^6.12.2",
    "twilio": "^4.22.0",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@typescript-eslint/eslint-plugin": "^8.12.1",
    "@typescript-eslint/parser": "^8.12.1",
    "eslint": "^9.7.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.29.1",
    "rimraf": "^5.0.5",
    "typescript": "^5.5.4",
    "vitest": "^1.6.0"
  }
}